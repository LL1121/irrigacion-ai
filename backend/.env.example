DATABASE_URL=postgresql://postgres:postgres_local_pass@localhost:5434/irrigacion_db

# Groq — chat / agente
GROQ_API_KEY=gsk-your-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=openai/gpt-oss-120b

# Gemini — OCR, embeddings y centinela
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-flash-latest
OCR_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001

# --- Google OAuth (login + Calendar / Gmail / Drive) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ia.irrigacionmalargue.net/api/auth/google/callback
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
APP_JWT_SECRET=
APP_JWT_TTL_HOURS=168
# URL del front tras el callback OAuth (PWA en Cloudflare)
FRONTEND_PUBLIC_URL=https://ia.irrigacionmalargue.net
