# =============================================================================
# irrigacion-bot — variables de PRODUCCIÓN (oficina / LAN)
# Copiar a .env.production y completar. NUNCA commitear secretos.
#   cp .env.production.example .env.production
# =============================================================================

APP_ENV=production

# --- PostgreSQL ---
POSTGRES_DB=irrigacion_db
POSTGRES_USER=postgres
# Generar: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE

# --- Binding API (LAN) ---
# Ej: 0.0.0.0 para toda la LAN, o la IP del servidor (192.168.x.x)
API_HOST_BIND=0.0.0.0
API_PORT=8000

# --- OpenAI / OpenClaw ---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
OCR_MODEL=gpt-4o-mini
CHAT_MODEL=gpt-4o-mini

# --- Gemini (centinela de skills) ---
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-2.5-flash

# --- CORS: orígenes de la app de escritorio / navegadores de confianza ---
# Separados por coma. En Tauri el origen suele ser http://tauri.localhost
# o tauri://localhost según plataforma. Agregá IPs de PCs si abrís la UI web.
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://127.0.0.1:1420,http://localhost:1420

# --- Sandbox ---
SKILL_SANDBOX_IMAGE=skill-sandbox-image
# Directorio en el HOST compartido con el contenedor API (mismo path absoluto)
SKILL_HOST_DIR=/var/lib/irrigacion/skills
SKILL_WORKSPACE_DIR=/var/lib/irrigacion/skills

# GID del grupo docker en el host (id -g docker). Suele ser 999 o 998.
DOCKER_GID=999
