# =============================================================================
# irrigacion-bot — variables de entorno (servidor / lab)
# Copiar a .env y completar. NUNCA commitear secretos.
#   cp .env.example .env
# =============================================================================

APP_ENV=production

# --- PostgreSQL ---
POSTGRES_DB=irrigacion_db
POSTGRES_USER=postgres
# Generar: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE

# --- Binding API ---
# 0.0.0.0 escucha en LAN + interfaz Tailscale (100.x)
API_HOST_BIND=0.0.0.0
API_PORT=8000

# URL pública documentada (clientes Tailscale + build Tauri)
API_PUBLIC_URL=http://100.68.57.77:8000
# Alternativa LAN oficina (PWA móvil en red local)
LAN_API_URL=http://172.30.12.101:8000

# --- Groq (chat principal) ---
GROQ_API_KEY=gsk-your-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=llama-3.3-70b-versatile

# Presupuestos de tokens aproximados (protección anti rate-limit Groq ~12k TPM)
# LLM_REQUEST_MAX_TOKENS=9000
# LLM_RAG_MAX_TOKENS=3500
# LLM_HISTORY_MAX_TOKENS=1800
# LLM_USER_MAX_TOKENS=1500
# LLM_SKILL_RESULT_MAX_TOKENS=1200

# --- Gemini (OCR, embeddings, centinela de skills) ---
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-flash-latest
OCR_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001

# --- CORS (solo aplica a clientes cross-origin: Tauri, dev Vite) ---
# La PWA servida desde el mismo :8000 NO necesita CORS (same-origin).
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://127.0.0.1:1420,http://localhost:1420

# --- Skills ---
# inline = ejecuta en el proceso del API (simple; menos aislamiento).
# sandbox = contenedor Docker efímero (requiere imagen skill-sandbox-image + docker.sock).
SKILL_EXECUTION_MODE=inline
SKILL_SANDBOX_IMAGE=skill-sandbox-image
SKILL_HOST_DIR=/var/lib/irrigacion/skills
SKILL_WORKSPACE_DIR=/var/lib/irrigacion/skills

# --- Auto-updater Tauri (manifiesto + .tar.gz firmados) ---
UPDATES_HOST_DIR=./updates

# GID del grupo docker en el host (id -g docker)
DOCKER_GID=999

# Red externa de nginx/reverse-proxy (compose adjunta el API ahí al levantar)
PROXY_NETWORK=proxy-network
